# Τα scripts που τρέχουν ΜΕΣΑ στον container μένουν LF ό,τι κι αν λέει το
# core.autocrlf του μηχανήματος. Ένα entrypoint.sh με CRLF δίνει
# «/bin/sh^M: bad interpreter» και ο container δεν ξεκινά καν.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Βιβλιοθήκες τρίτων: μένουν ΑΚΡΙΒΩΣ όπως κατέβηκαν. Ένα minified .js που
# περνά από μετατροπή γραμμών δεν σπάει, αλλά παύει να είναι byte-identical με
# την πηγή του — και τότε δεν μπορείς να το επαληθεύσεις ξανακατεβάζοντάς το.
assets/vendor/** -text
desktop/backend/etimologio/assets/vendor/** -text

# Τα vendored bundles (jsPDF κ.λπ.) δεν τα αγγίζει κανείς: χωρίς αυτό, το
# autocrlf τα ξαναγράφει ανά κλάδο και οι δύο γραμμές «διαφέρουν» χωρίς λόγο.
assets/vendor/** -text
desktop/backend/etimologio/assets/vendor/** -text
