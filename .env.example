# Αντίγραψέ το σε .env και συμπλήρωσε. Το .env είναι gitignored — ΠΟΤΕ στο git.

# --- Βάση δεδομένων ---------------------------------------------------------
POSTGRES_DB=etimologio
POSTGRES_USER=etimologio
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ΣΤΟ COOLIFY: η Postgres δίνεται ως ΕΝΑ connection string. Κόλλα το εδώ και
# μην ορίσεις DB_DSN/DB_USER/DB_PASS — το entrypoint το σπάει μόνο του.
#   DATABASE_URL=postgres://χρήστης:κωδικός@host:5432/etimologio
# (Με το compose του repo δεν χρειάζεται: τα στοιχεία περνούν από πάνω.)
#DATABASE_URL=

# --- Πρώτος διαχειριστής ----------------------------------------------------
MASTER_ADMIN_EMAIL=admin@example.gr
# Χρειάζεται ΜΟΝΟ στην πρώτη εκκίνηση: αποθηκεύεται hashed στη βάση.
# Μετά την πρώτη επιτυχή σύνδεση, άδειασέ το και κάνε redeploy.
MASTER_ADMIN_PASSWORD=

# --- Δημόσιο URL ------------------------------------------------------------
# Το hostname που θα δώσει το cloudflared (δες CLOUDFLARED.md). Χωρίς / στο τέλος.
# Μπαίνει στους συνδέσμους των email (ενεργοποίηση, επαναφορά κωδικού).
APP_URL=https://timologio.example.gr

# --- Χρονοπρογραμματισμός ---------------------------------------------------
# openssl rand -hex 24  ·  κενό = απενεργοποιημένη η αυτόματη έκδοση
SCHED_TOKEN=

# --- Email ------------------------------------------------------------------
# auto = Resend αν υπάρχει κλειδί, αλλιώς SMTP
MAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_EMAIL_SENDER=e-Τιμολόγιο <no-reply@example.gr>
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, θύρα 587) · ssl (θύρα 465) · none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Παραλήπτης ειδοποιήσεων έκδοσης. «-» για καμία αποστολή.
NOTIFY_ADMIN_EMAIL=

# --- Κλειδί κρυπτογράφησης (προαιρετικό) ------------------------------------
# Κανονικά παράγεται μόνο του στο /data/.enckey. Ορίζοντάς το εδώ (ή ως μυστικό
# στο Coolify) τα δεδομένα διαβάζονται ακόμη κι αν χαθεί το volume.
# openssl rand -base64 32
# ΠΡΟΣΟΧΗ: σε βάση που ΕΧΕΙ ήδη δεδομένα, αλλαγή του κλειδιού τα κάνει άχρηστα.
ENCRYPTION_KEY=

# --- Ώρα & όρια PHP ---------------------------------------------------------
TZ=Europe/Athens
# Ανέβασέ τα μόνο αν χρειαστεί (πολύ μεγάλες μαζικές εξαγωγές PDF/ZIP).
#PHP_MEMORY_LIMIT=512M
#PHP_MAX_EXECUTION_TIME=300
#PHP_UPLOAD_MAX_FILESIZE=32M
